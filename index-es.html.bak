/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
            
            .version-card {
                width: 100%;
                max-width: 320px;
            }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
            
            .mode-img-learn, .mode-img-practice {
                height: 250px;
            }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
        }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
        
        @media (max-width: 480px) {
            h1 {
                font-size: 2.5rem;
            }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
            
            h2 {
                font-size: 1.8rem;
            }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
            
            .play-btn {
                width: 80%;
            }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
            
            .mode-img-learn, .mode-img-practice {
                height: 200px;
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
            }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
        }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
    </style>
</head>
<body>
    <!-- Selector de idioma -->
    <div id="lang-switcher">
        <select onchange="changeLang(this.value)">
            <option value="index.html">English</option>
            <option value="index-zh.html">简体中文</option>
            <option value="index-zh-tw.html">繁體中文</option>
            <option value="index-es.html" selected>Español</option>
            <option value="index-ja.html">日本語</option>
        </select>
    </div>
    <script>
        function changeLang(url) {
            window.location.href = url;
        }
/* Estilos del selector de idioma */ #lang-switcher { position: absolute; top: 20px; right: 20px; z-index: 100; } #lang-switcher select { padding: 8px 12px; border-radius: 5px; background-color: var(--primary-color); color: var(--background-color); border: 2px solid var(--text-color); font-family: "Arial", sans-serif; cursor: pointer; } #lang-switcher select:hover { background-color: var(--accent-color); }
    </script>

    <header>
        <div class="container">
            <h1 class="arcade-font">Pac-Man</h1>
            <p class="subtitle">¡El clásico juego de laberinto arcade, ahora en tu navegador!</p>
            <a href="game-es.html" class="play-btn">JUGAR AHORA</a>
        </div>
    </header>
    
    <section id="about">
        <div class="container">
            <h2>Sobre el Juego</h2>
            <p class="intro-text">
                Pac-Man es uno de los juegos arcade más populares de todos los tiempos. Desde su lanzamiento en 1980, este icónico juego ha cautivado a generaciones de jugadores con su jugabilidad simple y adictiva. ¡Recorre el laberinto, come todos los puntos, esquiva a los fantasmas y alcanza la máxima puntuación!
            </p>
            
            <div class="features">
                <div class="feature-card">
                    <h3>Jugabilidad Clásica</h3>
                    <p>Disfruta de la experiencia original de Pac-Man, con gráficos, sonidos y mecánicas auténticas del arcade.</p>
                </div>
                <div class="feature-card">
                    <h3>Gratis para Jugar</h3>
                    <p>No necesitas descargar, suscribirte ni ver anuncios. ¡Solo abre tu navegador y comienza a jugar!</p>
                </div>
                <div class="feature-card">
                    <h3>Múltiples Versiones</h3>
                    <p>Explora varias versiones clásicas, incluyendo el Pac-Man original, Ms. Pac-Man y el innovador modo Cookie Man.</p>
                </div>
            </div>
        </div>
    </section>
    
    <section id="game-versions">
        <div class="container">
            <h2>Versiones del Juego</h2>
            <p class="intro-text">
                Ofrecemos varias versiones clásicas de Pac-Man, cada una con características y jugabilidad únicas. ¡Elige tu favorita y comienza a jugar!
            </p>
            
            <div class="game-versions">
                <div class="version-card">
                    <div class="version-info">
                        <h3>Pac-Man</h3>
                        <p>El clásico original de Namco de 1980. Disfruta de la jugabilidad auténtica, persigue la máxima puntuación y esquiva a los fantasmas.</p>
                    </div>
                    <div class="version-img">
                        <img src="images/pacman-version.jpg" alt="Versión Pac-Man" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                </div>
                <div class="version-card">
                    <div class="version-info">
                        <h3>Ms. Pac-Man</h3>
                        <p>La versión mejorada de GCC/Midway de 1981. Con más laberintos y mecánicas mejoradas, ¡se convirtió en un clásico por derecho propio!</p>
                    </div>
                    <div class="version-img">
                        <img src="images/mspacman-version.jpg" alt="Versión Ms. Pac-Man" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                </div>
                <div class="version-card">
                    <div class="version-info">
                        <h3>Cookie Man</h3>
                        <p>Una versión innovadora con <b>generador de mapas procedural</b>, ¡cada nivel presenta un laberinto diferente!</p>
                    </div>
                    <div class="version-img">
                        <img src="images/cookieman-version.jpg" alt="Versión Cookie Man" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <section id="game-modes">
        <div class="container">
            <h2>Modos de Juego</h2>
            <p class="intro-text">
                Cada versión ofrece varios modos de juego para satisfacer diferentes estilos de juego. ¡Desde principiantes hasta expertos, hay un modo para ti!
            </p>
            
            <div class="special-modes">
                <div class="mode-card-wide">
                    <div class="mode-info">
                        <h3>Modo Aprendizaje</h3>
                        <p>Visualiza el comportamiento de los fantasmas. Los bloques de colores muestran los objetivos de los fantasmas, ayudándote a entender la IA y mejorar tu estrategia.</p>
                    </div>
                    <div class="mode-img-learn">
                        <img src="images/learn-mode.jpg" alt="Modo Aprendizaje" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                </div>
                
                <div class="mode-card-wide">
                    <div class="mode-info">
                        <h3>Modo Práctica</h3>
                        <p>Incluye cámara lenta, retroceso temporal, invencibilidad y visualización de IA. Perfecto para dominar el juego y estudiar las mecánicas.</p>
                    </div>
                    <div class="mode-img-practice">
                        <img src="images/practice-mode.jpg" alt="Modo Práctica" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                </div>
            </div>
            
            <div class="turbo-mode">
                <div class="turbo-card">
                    <h3>Modo Turbo</h3>
                    <p>Un modo acelerado inspirado en modificaciones de arcade. Pac-Man se mueve al doble de velocidad y no se ralentiza al comer puntos. ¡Para jugadores que buscan un desafío extremo!</p>
                </div>
            </div>
        </div>
    </section>
    
    <section id="controls">
        <div class="container">
            <h2>Controles</h2>
            <p class="intro-text">
                Los controles de Pac-Man son simples e intuitivos. Aquí tienes los controles básicos y las funciones especiales.
            </p>
            
            <div class="controls">
                <div class="control-card">
                    <h3>Controles Básicos</h3>
                    <ul>
                        <li><b>Deslizar</b>: Controla a Pac-Man en dispositivos móviles</li>
                        <li><b>Flechas</b>: Mueve a Pac-Man</li>
                        <li><b>Tecla End</b>: Pausa el juego</li>
                        <li><b>Tecla Esc</b>: Abre el menú</li>
                    </ul>
                </div>
                <div class="control-card">
                    <h3>Controles del Modo Práctica</h3>
                    <ul>
                        <li><b>Shift</b>: Mantén para retroceder el tiempo</li>
                        <li><b>1</b>: Mantén para velocidad 0.5x</li>
                        <li><b>2</b>: Mantén para velocidad 0.25x</li>
                        <li><b>o</b>: Activa/desactiva modo turbo</li>
                        <li><b>i</b>: Activa/desactiva invencibilidad</li>
                        <li><b>q,w,e,r,t</b>: Muestra objetivos de Blinky, Pinky, Inky, Clyde y Pac-Man</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    
    <footer>
        <div class="container">
            <!-- Pie de página -->
        </div>
    </footer>
</body>
</html>